# Pflichtfeld: zufälliger, langer Wert, z. B. per `openssl rand -hex 32`.
# Die App verweigert den Start, wenn hier nichts oder nur ein Platzhalter
# steht - mit einem bekannten Schlüssel ließen sich Session-Cookies fälschen.
SECRET_KEY=
DATABASE_URL=sqlite:///slothtix.db

# Initialer Admin-Bootstrap (nur beim allerersten Start relevant)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Geheimnisse für LDAP/SMTP - die übrige Konfiguration (Server, Base-DN,
# AD-Gruppen, ...) erfolgt später über die Admin-Oberfläche unter
# /admin/einstellungen, nicht hier.
LDAP_BIND_PASSWORD=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Das Zertifikat des Mailservers wird bei STARTTLS geprüft. Nutzt der
# Server ein Zertifikat der eigenen CA, hier den Pfad zur PEM-Datei
# angeben (analog zu LDAP_CA_CERT_PATH). Leer lassen = System-CAs.
SMTP_CA_CERT_PATH=
# Nur als Notausgang für selbstsignierte Zertifikate: schaltet die
# Prüfung komplett ab und macht den Mailversand angreifbar.
SMTP_TLS_INSECURE=false

# CA-Zertifikat für die LDAPS-Prüfung (z. B. UCS-Root-CA). Datei unter
# ./certs/ ablegen (wird per docker-compose.yml gemountet). Ohne diesen
# Pfad wird das Server-Zertifikat NICHT geprüft.
LDAP_CA_CERT_PATH=/app/certs/ucs-ca.pem

# Das mitgelieferte docker-compose.yml stellt immer Caddy mit TLS davor,
# deshalb hier true. Sorgt für sichere Session-Cookies und korrekte
# https://-Links in E-Mails. NUR beim lokalen Entwickeln ohne Proxy/TLS auf
# false setzen - sonst kommt kein Login zustande.
FORCE_HTTPS=true

# Zeitzone (IANA-Name), in der Zeitstempel (Tickets, Kommentare, Historie)
# den Benutzern angezeigt werden. Intern wird immer in UTC gespeichert.
TIMEZONE=Europe/Berlin

# Hostname, unter dem das Tool erreichbar ist. Caddy holt hierfür
# automatisch ein TLS-Zertifikat (Let's Encrypt), das setzt einen von
# außen erreichbaren DNS-Namen voraus.
SITE_DOMAIN=tickets.example.org
